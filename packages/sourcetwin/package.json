{
  "name": "sourcetwin",
  "version": "0.1.0",
  "description": "A version-controlled, plain-language semantic twin of a codebase.",
  "type": "module",
  "bin": {
    "sourcetwin": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "npm run build && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "vitest": "3.2.4"
  }
}
