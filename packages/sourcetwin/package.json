{
  "name": "sourcetwin",
  "version": "0.1.0",
  "description": "A version-controlled, plain-language semantic twin of a codebase.",
  "author": "Source Twin contributors",
  "license": "Apache-2.0",
  "keywords": [
    "ai-agents",
    "code-review",
    "documentation",
    "semantic-code",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "sourcetwin": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "npm run build && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ast-grep/cli": "0.45.0",
    "commander": "15.0.0",
    "execa": "10.0.1",
    "fast-glob": "3.3.3",
    "mdast-util-to-string": "4.0.0",
    "p-limit": "7.2.0",
    "remark-frontmatter": "5.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "rimraf": "6.1.3",
    "vitest": "3.2.4"
  }
}
